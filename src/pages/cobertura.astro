---
import { MapPin } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import MapEmbed from '../components/MapEmbed.astro';
import PageHero from '../components/PageHero.astro';
import ProofBand from '../components/ProofBand.astro';
import { coverageMapEmbedUrl, coverageDestinations, whatsappUrl } from '../data/site';

const whatsapp = whatsappUrl('Hola, quisiera consultar un envío y la disponibilidad de productos para mi ubicación.');
---

<BaseLayout
  title="Ubicación y cobertura | Plásticos Santuario"
  description="Visita el punto principal de Plásticos Santuario en Caucasia y conoce los destinos de envío. Si estás en otra parte del país, consúltanos por WhatsApp."
>
  <PageHero
    breadcrumb="Ubicación y cobertura"
    eyebrow="Ubicación y cobertura"
    title="Más cerca de tu negocio,"
    accent="desde Caucasia."
    description="Te esperamos para conocer lo que necesitas, mostrarte nuestras líneas de productos y ayudarte a elegir opciones para tu negocio. Si te encuentras en otra población, también puedes consultar nuestros destinos de envío."
  />

  <ProofBand label="Accesos de ubicación y cobertura" items={[
    { href: '#explorar-cobertura', title: 'Punto principal', detail: 'Visítanos en Caucasia', icon: 'store' },
    { href: '#destinations-title', title: 'Destinos de envío', detail: 'Conoce las poblaciones', icon: 'truck' },
    { href: whatsapp, title: '¿Estás en otra ciudad?', detail: 'Escríbenos por WhatsApp', icon: 'message', external: true },
  ]} />

  <section class="section coverage-section" id="explorar-cobertura" aria-labelledby="coverage-title">
    <div class="container">
      <div class="coverage-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> Visítanos en Caucasia</p>
        <h2 id="coverage-title">Nuestro punto principal está en Caucasia.</h2>
        <p>Visítanos para descubrir opciones de empaques, desechables y productos complementarios pensadas para distintas formas de vender, servir y entregar. Cuéntanos cómo funciona tu negocio, qué producto quieres presentar y qué cantidad necesitas: podremos mostrarte formatos, comparar alternativas y ayudarte a encontrar una opción que se ajuste a tu día a día. Si ya tienes una referencia en mente, tráela o descríbenosla; estaremos encantados de revisar contigo las opciones disponibles.</p>
      </div>

      <div class="coverage-destinations" aria-labelledby="destinations-title">
        <div><p class="eyebrow"><span class="eyebrow-line"></span> Destinos de envío</p><h3 id="destinations-title">También enviamos a estas poblaciones.</h3><p>Si tu negocio está en alguno de estos destinos, escríbenos para consultar los productos disponibles y las condiciones de entrega de tu pedido.</p></div>
        <ul class="coverage-destination-list">
          {coverageDestinations.map((destination) => <li><MapPin size={15} aria-hidden="true" />{destination.name}</li>)}
        </ul>
      </div>
      <div class="coverage-map-wrap">
        <div class="coverage-map-label"><span class="eyebrow-line"></span><strong>Punto principal y destinos de envío</strong><span>Rojo: atención en Caucasia · Azul: destinos de envío</span></div>
        <MapEmbed src={coverageMapEmbedUrl} title="Mapa de Plásticos Santuario con el punto principal en Caucasia y catorce destinos de envío" />
      </div>
      <div class="coverage-other">
        <p>¿Te encuentras en otro lugar del país? Cuéntanos dónde estás, qué productos buscas y la cantidad aproximada. Presiona el botón para consultar las opciones de envío disponibles.</p>
        <ActionLink href={whatsapp} external>Consultar por WhatsApp</ActionLink>
      </div>
    </div>
  </section>
</BaseLayout>
