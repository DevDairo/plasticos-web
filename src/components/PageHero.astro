---
import { ArrowRight } from '@lucide/astro';

interface Props {
  breadcrumb: string;
  parentBreadcrumb?: { label: string; href: string };
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
}

const { breadcrumb, parentBreadcrumb, eyebrow, title, accent, description } = Astro.props;
---

<section class="inner-hero" aria-labelledby="page-title">
  <div class="container inner-hero-content">
    <nav aria-label="Ruta de navegación" class="breadcrumb"><a href="/">Inicio</a><ArrowRight size={14} aria-hidden="true" />{parentBreadcrumb && <><a href={parentBreadcrumb.href}>{parentBreadcrumb.label}</a><ArrowRight size={14} aria-hidden="true" /></>}<span aria-current="page">{breadcrumb}</span></nav>
    <p class="eyebrow"><span class="eyebrow-line"></span> {eyebrow}</p>
    <h1 id="page-title">{title}{accent && <> <span>{accent}</span></>}</h1>
    <p>{description}</p>
  </div>
  <div class="inner-hero-ring" aria-hidden="true"></div>
</section>
