---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowRight, Leaf } from '@lucide/astro';

interface Props {
  breadcrumb: string;
  parentBreadcrumb?: { label: string; href: string };
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
  backgroundImage?: ImageMetadata;
  backgroundImageAlt?: string;
  mediaTheme?: 'eco' | 'service' | 'packaging' | 'food-boxes' | 'cocktails' | 'bottles';
}

const { breadcrumb, parentBreadcrumb, eyebrow, title, accent, description, backgroundImage, backgroundImageAlt, mediaTheme = 'eco' } = Astro.props;
const stackedLabels = {
  packaging: { first: 'EMPAQUES', second: 'Y BOLSAS' },
  'food-boxes': { first: 'CAJAS', second: 'PARA ALIMENTOS' },
  cocktails: { first: 'COCTELERÍA Y', second: 'REPOSTERÍA' },
  bottles: { first: 'BOTELLAS', second: 'Y FRASCOS' },
};
const stackedLabel = mediaTheme === 'packaging' || mediaTheme === 'food-boxes' || mediaTheme === 'cocktails' || mediaTheme === 'bottles'
  ? stackedLabels[mediaTheme]
  : undefined;
const hasStackedLabel = stackedLabel !== undefined;
---

<section class:list={['inner-hero', { 'inner-hero--with-image': backgroundImage, 'inner-hero--service': backgroundImage && mediaTheme === 'service', 'inner-hero--packaging': backgroundImage && hasStackedLabel }]} aria-labelledby="page-title">
  <div class="container inner-hero-content">
    <nav aria-label="Ruta de navegación" class="breadcrumb"><a href="/">Inicio</a><ArrowRight size={14} aria-hidden="true" />{parentBreadcrumb && <><a href={parentBreadcrumb.href}>{parentBreadcrumb.label}</a><ArrowRight size={14} aria-hidden="true" /></>}<span aria-current="page">{breadcrumb}</span></nav>
    <p class="eyebrow"><span class="eyebrow-line"></span> {eyebrow}</p>
    <h1 id="page-title">{title}{accent && <> <span>{accent}</span></>}</h1>
    <p>{description}</p>
  </div>
  {backgroundImage && (
    <div class:list={['inner-hero-media', { 'inner-hero-media--service': mediaTheme === 'service', 'inner-hero-media--packaging': hasStackedLabel }]}>
      {stackedLabel ? (
        <svg class:list={['inner-hero-packaging-wordmark', { 'inner-hero-food-boxes-wordmark': mediaTheme === 'food-boxes', 'inner-hero-cocktails-wordmark': mediaTheme === 'cocktails', 'inner-hero-bottles-wordmark': mediaTheme === 'bottles' }]} viewBox="0 0 460 110" aria-hidden="true">
          <text class="inner-hero-packaging-first" x="230" y="39" text-anchor="middle">{stackedLabel.first}</text>
          <text class="inner-hero-packaging-second" x="230" y="78" text-anchor="middle">{stackedLabel.second}</text>
          <path class="inner-hero-packaging-swoosh" d="M 97 98 Q 230 78 363 98" />
          {mediaTheme === 'cocktails' && <path class="inner-hero-cocktails-secondary-swoosh" d="M 135 105 Q 230 90 325 105" />}
          <path class="inner-hero-packaging-accent inner-hero-packaging-accent--green" d="M 54 17 42 5 M 48 38 30 31" />
          <path class="inner-hero-packaging-accent inner-hero-packaging-accent--red" d="M 406 17 418 5" />
          <path class="inner-hero-packaging-accent inner-hero-packaging-accent--lime" d="M 412 38 430 31" />
        </svg>
      ) : (
        <div class="inner-hero-media-heading" aria-hidden="true">
          {mediaTheme === 'eco' ? <Leaf class="inner-hero-leaf inner-hero-leaf--left" /> : <svg class="inner-hero-service-mark inner-hero-service-mark--left" viewBox="0 0 44 72" fill="none"><path d="M36 10 22 1M29 33 5 25M30 55 13 68" /></svg>}
          <svg class="inner-hero-media-wordmark" viewBox="0 0 460 100" xmlns="http://www.w3.org/2000/svg">
            <defs><path id="inner-hero-wordmark-curve" d="M 12 73 Q 230 8 448 73" /></defs>
            <text><textPath href="#inner-hero-wordmark-curve" startOffset="50%" text-anchor="middle">{breadcrumb.toUpperCase()}</textPath></text>
            <path class="inner-hero-media-swoosh" d="M 85 86 Q 230 57 375 86" />
          </svg>
          {mediaTheme === 'eco' ? <Leaf class="inner-hero-leaf inner-hero-leaf--right" /> : <svg class="inner-hero-service-mark inner-hero-service-mark--right" viewBox="0 0 44 72" fill="none"><path d="M36 10 22 1M29 33 5 25M30 55 13 68" /></svg>}
        </div>
      )}
      <Image src={backgroundImage} alt={backgroundImageAlt ?? `Imagen de ${breadcrumb}`} widths={[480, 960, 1440]} sizes="(max-width: 540px) 310px, (max-width: 950px) 520px, 44vw" format="webp" quality={82} decoding="async" fetchpriority="high" />
    </div>
  )}
  <div class="inner-hero-ring" aria-hidden="true"></div>
</section>
