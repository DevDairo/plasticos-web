---
import { BottleWine, CakeSlice, CupSoda, Leaf, Package, ShoppingBag } from '@lucide/astro';
import { productLines } from '../data/site';

interface Props {
  line: (typeof productLines)[number];
}

const { line } = Astro.props;
const icons = {
  'biodegradables': Leaf,
  'desechables': CupSoda,
  'empaques-y-bolsas': ShoppingBag,
  'cajas-para-alimentos': Package,
  'cocteleria-y-reposteria': CakeSlice,
  'botellas-y-frascos': BottleWine,
} as const;
const Icon = icons[line.slug];
---

<a class="line-illustration-link" href={`/lineas/${line.slug}/`} aria-label={`Conocer ${line.name}`}>
  <span class="line-illustration-art" aria-hidden="true">
    <Icon size={72} stroke-width={1.5} aria-hidden="true" />
  </span>
  <span class="line-illustration-name">{line.name}</span>
  <span class="line-illustration-detail">{line.detail}</span>
</a>
