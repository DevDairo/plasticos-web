---
import BrandMark from './BrandMark.astro';
import FacebookIcon from './FacebookIcon.astro';
import InstagramIcon from './InstagramIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { business, whatsappUrl } from '../data/site';

const whatsapp = whatsappUrl('Hola, quisiera información sobre sus productos.');
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-identity">
      <BrandMark />
      <p>Soluciones en empaques y productos para negocios, desde Caucasia.</p>
    </div>
    <div>
      <h2>Explora</h2>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/#lineas">Líneas de producto</a></li>
        <li><a href="/nosotros/">Quiénes somos</a></li>
        <li><a href="/cobertura/">Ubicación y cobertura</a></li>
        <li><a href="/#contacto">Contacto</a></li>
      </ul>
    </div>
    <div>
      <h2>Nuestras redes</h2>
      <ul class="footer-social-list">
        <li><a href={business.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Visitar Instagram de Plásticos Santuario"><InstagramIcon size={18} />Instagram</a></li>
        <li><a href={business.facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Visitar Facebook de Plásticos Santuario"><FacebookIcon size={18} />Facebook</a></li>
        <li><a href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Escribir a Plásticos Santuario por WhatsApp"><WhatsAppIcon size={18} />WhatsApp</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Plásticos Santuario</span>
    <span>{business.tagline}</span>
  </div>
</footer>
